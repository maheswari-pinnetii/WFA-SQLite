{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": false,
    "removeComments": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": false
  },
  "include": [
    "backend/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "frontend",
    "tests",
    "playwright",
    "**/*.test.ts",
    "**/*.spec.ts",
    "backend/src/services/shift.service.ts",
    "backend/src/services/attendanceWorkflow.service.ts",
    "backend/src/controllers/attendanceWorkflow.controller.ts",
    "backend/src/controllers/shift.controller.ts",
    "backend/src/controllers/performance.controller.ts"
  ]
}
