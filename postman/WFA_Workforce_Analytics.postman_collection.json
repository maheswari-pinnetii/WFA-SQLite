{
  "info": {
    "_postman_id": "c9837920-f1c1-4d1a-8532-a5a41bf8f921",
    "name": "WFA Workforce Analytics & Attendance API Suite",
    "description": "Production-ready Postman collection for testing the WFA Workforce Analytics and Geofenced Attendance Engine.\n\n### Quick Instructions:\n1. Select the **WFA Local Environment** in the environment dropdown.\n2. Execute **01 Auth & MFA > 1. Login (Email + Password)** or **2. Verify MFA Code**.\n3. The test script automatically stores the JWT token in `{{bearerToken}}`.\n4. Execute any protected endpoints (Attendance, Leaves, Corrections, Shifts, Analytics).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Auth & MFA",
      "item": [
        {
          "name": "1. Login (Email + Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Response has success true\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "});",
                  "if (res.data && res.data.token) {",
                  "    pm.environment.set(\"bearerToken\", res.data.token);",
                  "    console.log(\"Saved bearerToken to environment:\", res.data.token);",
                  "} else if (res.data && res.data.challengeId) {",
                  "    pm.environment.set(\"challengeId\", res.data.challengeId);",
                  "    console.log(\"MFA required. challengeId saved:\", res.data.challengeId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "description": "Authenticate user with email and password. Returns JWT token directly or challengeId if MFA is required."
          }
        },
        {
          "name": "2. Verify MFA Code (Email / TOTP OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Token received and saved\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data.token).to.be.a(\"string\");",
                  "    pm.environment.set(\"bearerToken\", res.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{employeeEmail}}\",\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/mfa/verify",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "mfa", "verify"]
            },
            "description": "Verify the 6-digit MFA OTP code."
          }
        },
        {
          "name": "3. Get Current User Profile (Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"User profile returned\", function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.data.user.email).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "me"]
            },
            "description": "Returns details of the currently authenticated session user."
          }
        },
        {
          "name": "4. Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) {",
                  "    pm.environment.set(\"bearerToken\", res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            },
            "description": "Exchange refresh cookie for a newly rotated access token."
          }
        },
        {
          "name": "5. TOTP MFA Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/mfa/totp/status",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "mfa", "totp", "status"]
            },
            "description": "Returns whether Google Authenticator TOTP is enabled."
          }
        },
        {
          "name": "6. Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"]
            },
            "description": "Revokes the active refresh token and destroys the server session."
          }
        }
      ]
