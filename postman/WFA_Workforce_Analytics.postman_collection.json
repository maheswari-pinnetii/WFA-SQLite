    {
      "name": "09 Backup & Disaster Recovery",
      "item": [
        {
          "name": "1. Trigger Database Hot Backup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.filename) {",
                  "    pm.environment.set(\"backupFilename\", res.data.filename);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag\": \"manual-postman-snapshot\",\n  \"compress\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/backups",
              "host": ["{{baseUrl}}"],
