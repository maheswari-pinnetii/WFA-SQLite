{
    "name": "wfa-sqlite-frontend-project",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "start": "tsx server.ts",
        "dev": "concurrently \"tsx watch server.ts\" \"vite\"",
        "server": "tsx watch server.ts",
        "frontend": "vite",
        "build": "node -e \"import('fs').then(fs => { try { fs.rmSync('dist', { recursive: true, force: true }); } catch(e) {} })\" && tsc && vite build",
        "preview": "vite preview",
        "test": "node -e \"try { require('fs').unlinkSync('database/sqlite/wfa-test.sqlite'); } catch(e) {}\" && vitest run --no-file-parallelism --test-timeout=20000",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:security": "vitest run tests/security",
        "test:coverage": "vitest run --coverage --no-file-parallelism --test-timeout=20000",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report playwright-report",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ext .ts,.tsx",
        "seed": "tsx backend/scripts/seed-sqlite.ts",
        "verify-db": "tsx backend/scripts/verify-sqlite.js",
        "db:verify-dataset": "tsx backend/scripts/verify-dataset.ts",
        "db:explain": "tsx backend/scripts/explain-queries.ts",
        "db:validate": "tsx backend/scripts/verify-sqlite.js && tsx backend/scripts/verify-dataset.ts && tsx backend/scripts/explain-queries.ts",
        "db:backup": "tsx backend/scripts/backup-db.ts",
        "db:restore": "tsx backend/scripts/restore-db.ts",
        "test:e2e": "npx playwright test"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/inter": "^5.3.0",
        "@hookform/resolvers": "^5.9.1",
        "@mui/icons-material": "^9.2.0",
        "@mui/material": "^9.2.0",
        "@reduxjs/toolkit": "^2.2.1",
        "@simplewebauthn/server": "^14.0.0",
        "@simplewebauthn/types": "^12.0.0",
        "@sqlitecloud/drivers": "^1.0.880",
        "@tanstack/react-query": "^5.28.4",
        "@types/nodemailer": "^8.0.1",
        "axios": "^1.6.7",
        "axios-retry": "^4.5.0",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^11.1.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.0",
        "cmdk": "^1.1.1",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "csv-parse": "^7.0.2",
        "date-fns": "^4.4.0",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "express-rate-limit": "^8.6.2",
        "framer-motion": "^13.1.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^0.475.0",
        "nodemailer": "^10.0.1",
        "otplib": "^13.4.1",
        "qrcode": "^1.5.4",
        "react": "^18.2.0",
        "react-bits": "^1.0.5",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.87.0",
        "react-redux": "^9.1.0",
        "react-router-dom": "^6.30.4",
        "react-scan": "^0.5.7",
        "recharts": "^3.10.1",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "tsx": "^4.23.12",
        "typescript": "^5.2.2",
        "zod": "^4.5.4",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.5",
        "@types/bcryptjs": "^2.4.6",
        "@types/better-sqlite3": "^7.6.11",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.11.20",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^18.2.56",
        "@types/react-dom": "^18.2.19",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitest/coverage-v8": "^1.3.1",
        "concurrently": "^10.0.4",
        "eslint": "^10.10.0",
        "eslint-plugin-security": "^4.0.1",
        "jsdom": "^29.1.1",
        "supertest": "^7.2.2",
        "vite": "^5.4.14",
        "vitest": "^1.3.1"
    },
    "overrides": {
        "esbuild": "^0.25.0",
        "vite": "^5.4.14",
        "qs": "^6.16.0"
    }
}
