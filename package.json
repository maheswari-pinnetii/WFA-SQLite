{
  "name": "wfa-sqlite-frontend-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx server.ts\" \"vite\"",
    "server": "tsx server.ts",
    "frontend": "vite",
    "build": "node -e \"import('fs').then(fs => { try { fs.rmSync('dist', { recursive: true, force: true }); } catch(e) {} })\" && tsc && vite build",
    "preview": "vite preview",
    "test": "node -e \"try { require('fs').unlinkSync('database/sqlite/wfa-test.sqlite'); } catch(e) {}\" && vitest run --no-file-parallelism --test-timeout=20000",
    "test:coverage": "vitest run --coverage --no-file-parallelism --test-timeout=20000",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "seed": "tsx backend/scripts/seed-sqlite.ts",
    "verify-db": "tsx backend/scripts/verify-sqlite.js",
    "db:verify-dataset": "tsx backend/scripts/verify-dataset.ts",
    "db:explain": "tsx backend/scripts/explain-queries.ts",
    "db:validate": "tsx backend/scripts/verify-sqlite.js && tsx backend/scripts/verify-dataset.ts && tsx backend/scripts/explain-queries.ts",
    "sqlitecloud:migrate": "node backend/scripts/migrate-sqlitecloud.js",
    "sqlitecloud:test": "node backend/scripts/test-sqlitecloud-connection.js",
    "db:backup": "tsx backend/scripts/backup-db.ts",
    "db:restore": "tsx backend/scripts/restore-db.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@reduxjs/toolkit": "^2.2.1",
    "@sqlitecloud/drivers": "^1.0.880",
    "@tanstack/react-query": "^5.28.4",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.1.2",
    "clsx": "^2.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.11.20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.3.1",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  }
}
