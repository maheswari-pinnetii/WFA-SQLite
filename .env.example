PORT=5001
NODE_ENV=development

# Database
SQLITE_DB_PATH=./database/sqlite/wfa.sqlite
SQLITE_CLOUD_CONNECTION_STRING=sqlitecloud://admin:your_password@your-project-id.sqlite.cloud:8860/wfa.sqlite

# Auth / JWT
JWT_SECRET=<STRONG_RANDOM_SECRET_MIN_32_CHARS>
JWT_REFRESH_SECRET=<STRONG_RANDOM_REFRESH_SECRET_MIN_32_CHARS>

# MFA
TOTP_ENCRYPTION_KEY=<GENERATE_A_32_BYTE_RANDOM_KEY>
MFA_ISSUER=WorkforceAnalytics

# CORS
# Comma-separated list of allowed origins.
# In development: defaults to http://localhost:3000, http://localhost:3001
# In production: set to your exact frontend domain(s) — anything not listed is blocked.
# Example: ALLOWED_ORIGINS=https://app.yourcompany.com,https://admin.yourcompany.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourcompany.com

# Frontend
VITE_COMPANY_NAME=Stackly
VITE_API_BASE_URL=http://localhost:5001

# Feature Flags
ENABLE_AI_INSIGHTS=true
ENABLE_PAYROLL_ENGINE=true
